---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import CharacterShowcase from "@components/CharacterShowcase.astro";

const books = (await getCollection("books", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = books.filter((book) => book.data.featured);
const shownBooks = featured.length > 0 ? featured : books;
---
<BaseLayout title="Libros infantiles para colorear gratis" description="Explora libros infantiles gratuitos para colorear por frutas, animales, fantasía y aventuras. Descarga e imprime en familia.">
  <SiteHeader />
  <main>
    <CharacterShowcase books={shownBooks} />
    <section id="como-funciona" class="container-page py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-black uppercase tracking-[.18em] text-[#987fc8]">Fácil y divertido</p>
        <h2 class="mt-2 text-3xl font-black text-ink">¿Cómo funciona?</h2>
        <p class="mt-3 text-[#777184]">Tres pasos sencillos para convertir una tarde cualquiera en una aventura creativa.</p>
      </div>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {[
          { icon: "📚", title: "Elige tu libro", text: "Explora las colecciones y encuentra tu tema favorito.", color: "bg-[#e9ddff]" },
          { icon: "⬇️", title: "Descárgalo gratis", text: "Abre la ficha del libro y descarga el PDF disponible.", color: "bg-[#dceeff]" },
          { icon: "🖍️", title: "¡A colorear!", text: "Imprime las páginas, prepara tus lápices y deja volar tu imaginación.", color: "bg-[#d9f3e7]" }
        ].map((step) => (
          <article class="step-card p-7 text-center">
            <div class:list={["mx-auto grid size-16 place-items-center rounded-3xl text-3xl", step.color]}>{step.icon}</div>
            <h3 class="mt-5 text-lg font-black text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-[#777184]">{step.text}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
