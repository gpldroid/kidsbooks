---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import HeroSpotlight from "@components/HeroSpotlight.astro";
import CategoryGrid from "@components/CategoryGrid.astro";
import SiteFooter from "@components/SiteFooter.astro";

const books = (await getCollection("books", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Biblioteca infantil: libros para colorear gratis" description="Explora libros infantiles gratuitos para colorear por frutas, animales, fantasía y aventuras. Descarga e imprime en familia.">
  <Header />
  <main>
    <HeroSpotlight />
    <CategoryGrid books={books} />
    <section id="descargas" class="download-guide">
      <div class="download-guide-inner">
        <p class="section-kicker">Fácil y divertido</p>
        <h2>¿Cómo descargar tu libro?</h2>
        <div class="download-steps">
          <article><span>📚</span><h3>1. Elige tu libro</h3><p>Encuentra una aventura que te guste en nuestra biblioteca.</p></article>
          <article><span>⬇️</span><h3>2. Descarga el PDF</h3><p>Abre la ficha del libro y pulsa el botón de descarga gratuita.</p></article>
          <article><span>🖍️</span><h3>3. ¡A colorear!</h3><p>Imprime las páginas, prepara tus lápices y disfruta creando.</p></article>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .download-guide { padding:4rem 1.25rem; background:#f1f8f5; text-align:center; }.download-guide-inner { width:min(100%,1050px); margin:auto; }.download-guide h2 { margin:.4rem 0 0; color:#35566b; font-size:clamp(1.8rem,3vw,2.4rem); font-weight:1000; }.download-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:2rem; }.download-steps article { padding:1.5rem; border:1px solid #e2ece6; border-radius:1.4rem; background:#fff; }.download-steps article>span { font-size:2.2rem; }.download-steps h3 { margin:.7rem 0 .3rem; color:#38596b; font-size:1rem; font-weight:950; }.download-steps p { margin:0; color:#858087; font-size:.85rem; line-height:1.7; }
  @media(max-width:650px) { .download-steps { grid-template-columns:1fr; } }
</style>
