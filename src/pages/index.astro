---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import HeroSpotlight from "@components/HeroSpotlight.astro";
import CategoryGrid from "@components/CategoryGrid.astro";
import SiteFooter from "@components/SiteFooter.astro";

const books = (await getCollection("books", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Biblioteca infantil: libros para colorear gratis" description="Explora libros infantiles gratuitos para colorear por frutas, animales, fantasía, naturaleza y aventuras. Descarga e imprime en familia." keywords={["libros infantiles para colorear", "libros para colorear gratis", "PDF para imprimir", "dibujos para niños", "actividades creativas infantiles"]}>
  <Header />
  <main>
    <HeroSpotlight />
    <CategoryGrid books={books} />
    <section id="descargas" class="download-guide">
      <div class="download-guide-inner">
        <p class="section-kicker">Fácil y divertido</p>
        <h2>¿Cómo descargar tu libro?</h2>
        <div class="download-steps">
          <article class="step-card"><span class="step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z"/><path d="M4 5.5v16M8 7h8M8 11h7"/></svg></span><h3>1. Elige tu libro</h3><p>Encuentra una aventura que te guste en nuestra biblioteca.</p></article>
          <article class="step-card"><span class="step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 17v4h14v-4"/></svg></span><h3>2. Descarga el PDF</h3><p>Abre la ficha del libro y pulsa el botón de descarga gratuita.</p></article>
          <article class="step-card"><span class="step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 16 10-10 4 4L8 20H4v-4Z"/><path d="m12 8 4 4M14 4l2-2 4 4-2 2"/></svg></span><h3>3. ¡A colorear!</h3><p>Imprime las páginas, prepara tus lápices y disfruta creando.</p></article>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .download-guide { padding:4rem 1.25rem; background:#f2f8f3; text-align:center; }.download-guide-inner { width:min(100%,1050px); margin:auto; }.download-guide h2 { margin:.4rem 0 0; color:#26352d; font-size:clamp(1.8rem,3vw,2.4rem); font-weight:1000; }.download-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:2rem; }.download-steps article { padding:1.5rem; border:1px solid #e2ece6; border-radius:1.4rem; background:#fff; }.download-steps article>span { display:grid; width:3.2rem; height:3.2rem; place-items:center; margin-inline:auto; border:1px solid #e2ebe4; border-radius:1.1rem; background:linear-gradient(145deg,#fff,#edf5ef); color:#16834a; box-shadow:0 4px 0 #d4e8da,0 8px 16px rgb(68 54 89 / 7%); }.download-steps article>span svg { width:1.55rem; height:1.55rem; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }.download-steps h3 { margin:.7rem 0 .3rem; color:#26352d; font-size:1rem; font-weight:950; }.download-steps p { margin:0; color:#68776d; font-size:.85rem; line-height:1.7; }
  @media(max-width:650px) { .download-steps { grid-template-columns:1fr; } }
</style>
