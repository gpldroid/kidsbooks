---
import BaseLayout from "@layouts/BaseLayout.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Página no encontrada" description="La página que buscas no está disponible.">
  <SiteHeader />
  <main class="container-page grid min-h-[65vh] place-items-center py-16 text-center">
    <div class="max-w-lg">
      <div class="mx-auto grid size-24 place-items-center rounded-[2rem] bg-[#e9ddff] text-5xl" aria-hidden="true">🖍️</div>
      <p class="mt-7 text-sm font-black uppercase tracking-[.2em] text-[#987fc8]">Error 404</p>
      <h1 class="mt-3 text-4xl font-black text-ink">¡Ups! Esta página se ha perdido</h1>
      <p class="mt-4 leading-7 text-[#777184]">No encontramos lo que buscabas. Vuelve a la biblioteca y descubre algo bonito para colorear.</p>
      <a class="focus-ring mt-7 inline-flex rounded-full bg-[#8f78bd] px-7 py-3.5 font-extrabold text-white hover:bg-[#7860a7]" href={base}>Volver al inicio</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
