---
import "@styles/global.css";
import ScrollControls from "@components/ScrollControls.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  type?: "website" | "article";
}

const { title, description, ogImage, noIndex = false, type = "website" } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = ogImage ? new URL(ogImage.startsWith("/") ? `${base.replace(/\/$/, "")}${ogImage}` : ogImage, Astro.site).href : new URL(`${base}favicon.svg`, Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${new URL(base, Astro.site).href}#website`,
      "url": new URL(base, Astro.site).href,
      "name": "kids books",
      "description": "Libros infantiles gratuitos para colorear e imprimir."
    },
    {
      "@type": "Organization",
      "@id": `${new URL(base, Astro.site).href}#organization`,
      "name": "kids books",
      "url": new URL(base, Astro.site).href,
      "logo": image
    }
  ]
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#16834A" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="kids books" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title} | kids books</title>
  </head>
  <body>
    <slot />
    <ScrollControls />
  </body>
</html>
