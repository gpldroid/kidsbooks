---
const base = import.meta.env.BASE_URL;
const shareUrl = "https://gpldroid.github.io/kidsbooks/";
const shareText = "Descubre libros infantiles gratuitos para colorear en kids books.";
---
<footer class="site-footer">
  <div class="container-page grid gap-9 py-12 md:grid-cols-[1.2fr_.8fr] md:items-center">
    <div>
      <a class="brand-link" href={base} aria-label="kids books, inicio">
        <span class="brand-mark" aria-hidden="true">✿</span>
        <span class="brand-name">kids books<span>.</span></span>
      </a>
      <p class="mt-4 max-w-md text-sm leading-7 text-muted">Un espacio para imaginar, aprender y compartir momentos creativos en familia.</p>
      <p class="mt-5 text-xs font-bold text-muted">© {new Date().getFullYear()} kids books. Hecho para pequeños artistas.</p>
    </div>
    <div class="md:justify-self-end">
      <h2 class="text-sm font-black text-ink">Comparte la creatividad</h2>
      <div class="mt-4 flex gap-3" aria-label="Compartir kids books">
        <a class="social-link" href={`https://wa.me/?text=${encodeURIComponent(shareText + " " + shareUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Compartir por WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.3-4.7a8.5 8.5 0 1 1 16.2-4z"/><path d="M8.5 8.2c.3-.7.7-.7 1-.7h.5c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4 0 .6.6 1 1.4 1.7 2.4 2.2.2.1.4.1.6-.1l.8-1c.2-.2.4-.3.7-.2l1.7.8c.3.1.4.3.4.5 0 .4-.2 1.1-.7 1.5-.5.5-1.2.7-1.9.6-1.1-.2-2.4-.8-3.8-2-1.2-1.1-2.1-2.4-2.3-3.4-.2-.8 0-1.5.4-2z"/></svg>
        </a>
        <a class="social-link" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h2.7l.4-3H14V8.1c0-.9.3-1.5 1.6-1.5h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3V10H8v3h2.6v8z"/></svg>
        </a>
        <a class="social-link" href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(shareUrl)}&description=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Pinterest">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.3 17.4c0-.8 0-1.6.2-2.3l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.4-.3 1 .5 1.8 1.5 1.8 1.8 0 3.1-2.3 3.1-5 0-2.1-1.4-3.7-4-3.7-2.9 0-4.7 2.2-4.7 4.6 0 .8.2 1.4.6 1.9.2.2.2.3.1.6l-.2.7c-.1.2-.3.3-.5.2-1.3-.5-1.9-1.8-1.9-3.3 0-2.5 2.1-5.5 6.8-5.5 3.6 0 6 2.6 6 5.4 0 3.7-2.1 6.5-5.2 6.5-1 0-2-.6-2.3-1.2l-.7 2.7c-.2.8-.7 1.6-1.1 2.2A9 9 0 1 0 12 3z"/></svg>
        </a>
      </div>
      <p class="mt-4 text-xs text-muted">Comparte tus libros favoritos con otras familias.</p>
    </div>
  </div>
</footer>
