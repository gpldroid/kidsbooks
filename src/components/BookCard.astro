---
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
}

const { book } = Astro.props;
const base = import.meta.env.BASE_URL;
const coverUrl = `${base}${book.data.cover.replace(/^\/+/, "")}`;
---
<article class="book-card group">
  <a class="focus-ring block rounded-[1.7rem]" href={`${base}libros/${book.data.slug}/`}>
    <div class="book-card-media aspect-[4/3] p-4">
      <img
        src={coverUrl}
        alt={`Portada: ${book.data.title}`}
        loading="lazy"
        class="h-full w-full rounded-2xl object-cover"
      />
    </div>
    <div class="p-5">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-extrabold">
        <span class="rounded-full bg-[#e9ddff] px-3 py-1 text-[#66518e]">{book.data.category}</span>
        <span class="rounded-full bg-[#d9f3e7] px-3 py-1 text-[#47765f]">Gratis</span>
      </div>
      <h2 class="text-lg font-black tracking-tight text-ink">{book.data.title}</h2>
      <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted">{book.data.description}</p>
      <div class="mt-5 flex items-center justify-between border-t border-[#f0ebf3] pt-4 text-xs font-extrabold text-muted">
        <span class="inline-flex items-center gap-1.5"><span aria-hidden="true">✿</span> {book.data.age} años</span>
        <span>{book.data.pages} páginas <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </a>
</article>
