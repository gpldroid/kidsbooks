---
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
}

const { book } = Astro.props;
const base = import.meta.env.BASE_URL;
const coverUrl = `${base}${book.data.cover.replace(/^\/+/, "")}`;
const detailUrl = `${base}libros/${book.data.slug}/`;
---
<article class="book-card group">
  <a class="book-card-link focus-ring" href={detailUrl} aria-label={`Ver el libro ${book.data.title}`}>
    <div class="book-card-stage">
      <div class="book-card-media">
        <span class="book-card-ribbon">PDF GRATIS</span>
        <span class="book-card-glow" aria-hidden="true"></span>
        <img
          src={coverUrl}
          alt={`Portada: ${book.data.title}`}
          loading="lazy"
          decoding="async"
          class="book-cover"
        />
        <span class="book-card-pages" aria-hidden="true"></span>
      </div>
    </div>
    <div class="book-card-content">
      <div class="book-card-tags">
        <span class="book-tag book-tag-category">{book.data.category}</span>
        <span class="book-tag book-tag-free"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 17v4h14v-4"/></svg> Gratis</span>
      </div>
      <h2>{book.data.title}</h2>
      <p class="book-card-description">{book.data.description}</p>
      <div class="book-card-footer">
        <span class="book-meta"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3.5 20v-1.5A5.5 5.5 0 0 1 9 13h.5a5.5 5.5 0 0 1 5.5 5.5V20H3.5Z"/><path d="M16 5.5a3 3 0 0 1 0 5.8"/></svg>{book.data.age} años</span>
        <span class="book-meta"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5h11l3 3V21H5z"/><path d="M8 3.5v6h8v-6M8 21v-7h8v7"/></svg>{book.data.pages} páginas</span>
        <span class="book-open-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
      </div>
    </div>
  </a>
</article>
<style>
  .book-card { height:100%; border:1px solid #e9e2ed; border-radius:1.55rem; background:linear-gradient(155deg,#fff 0%,#fff 72%,#faf7ff 100%); box-shadow:0 4px 0 #e7deed,0 10px 18px rgb(68 54 89 / 7%),0 22px 38px rgb(68 54 89 / 6%); transform:perspective(1100px) translateY(0) rotateX(0); transition:transform .32s cubic-bezier(.2,.8,.2,1),box-shadow .32s,border-color .32s; }
  .book-card:hover { transform:perspective(1100px) translateY(-7px) rotateX(1.5deg); border-color:#d5c7e8; box-shadow:0 5px 0 #ddd0ea,0 15px 26px rgb(68 54 89 / 10%),0 28px 48px rgb(68 54 89 / 12%); }
  .book-card-link { display:flex; height:100%; flex-direction:column; overflow:hidden; border-radius:inherit; color:inherit; text-decoration:none; }
  .book-card-stage { display:grid; min-height:210px; place-items:center; padding:1rem 1rem .65rem; background:radial-gradient(ellipse at 50% 40%,#fff 0%,#f4effa 58%,#e8f3ed 100%); }
  .book-card-media { position:relative; display:grid; width:min(100%,205px); aspect-ratio:3/4; place-items:center; isolation:isolate; }
  .book-card-media::before { position:absolute; z-index:-1; inset:9px -7px -5px 9px; border:1px solid rgb(73 60 93 / 12%); border-radius:.55rem; background:linear-gradient(90deg,#d7cde2,#fff 18%,#eee8f4); box-shadow:5px 7px 12px rgb(49 42 65 / 13%); content:""; transform:translateZ(-10px); }
  .book-cover { position:relative; z-index:1; width:100%; height:100%; border:1px solid rgb(255 255 255 / 80%); border-radius:.55rem; object-fit:cover; box-shadow:inset 3px 0 5px rgb(255 255 255 / 40%),5px 9px 16px rgb(49 42 65 / 20%); transform:perspective(650px) rotateY(-4deg); transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s; }
  .book-card:hover .book-cover { transform:perspective(650px) rotateY(-1deg) translateY(-3px); box-shadow:inset 3px 0 5px rgb(255 255 255 / 40%),8px 13px 20px rgb(49 42 65 / 23%); }
  .book-card-pages { position:absolute; z-index:0; top:5px; right:-5px; bottom:5px; width:8px; border-radius:0 4px 4px 0; background:repeating-linear-gradient(180deg,#fff 0 3px,#e8e2ee 3px 4px); transform:skewY(-2deg); }
  .book-card-ribbon { position:absolute; z-index:3; top:9px; left:-5px; padding:.35rem .6rem; border:1px solid #c5e3d4; border-radius:.45rem; background:#e1f4e9; color:#47765f; font-size:.58rem; font-weight:1000; letter-spacing:.07em; box-shadow:0 3px 7px rgb(49 80 61 / 10%); }
  .book-card-glow { position:absolute; z-index:-2; inset:15% 10%; border-radius:50%; background:#d7c7ee; filter:blur(28px); opacity:.45; }
  .book-card-content { display:flex; flex:1; flex-direction:column; padding:1rem 1.1rem 1.1rem; }
  .book-card-tags { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem; }
  .book-tag { display:inline-flex; align-items:center; gap:.3rem; border-radius:999px; padding:.32rem .62rem; font-size:.66rem; font-weight:950; }
  .book-tag-category { background:#eee7fa; color:#70599c; }.book-tag-free { background:#e1f4e9; color:#47765f; }
  .book-tag-free svg,.book-meta svg { width:.9rem; height:.9rem; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .book-card-content h2 { margin:.8rem 0 0; color:#343247; font-size:1.03rem; font-weight:1000; letter-spacing:-.025em; line-height:1.35; }
  .book-card-description { display:-webkit-box; overflow:hidden; margin:.45rem 0 1rem; color:#777184; font-size:.78rem; line-height:1.65; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .book-card-footer { display:flex; align-items:center; gap:.6rem; margin-top:auto; padding-top:.75rem; border-top:1px solid #f0ebf3; }
  .book-meta { display:inline-flex; align-items:center; gap:.25rem; color:#777184; font-size:.68rem; font-weight:850; white-space:nowrap; }
  .book-open-icon { display:grid; width:1.85rem; height:1.85rem; place-items:center; margin-left:auto; border:1px solid #e7dff0; border-radius:.7rem; background:#f5f0fa; color:#8068ad; box-shadow:0 3px 0 #e7dff0; transition:transform .2s,box-shadow .2s,background .2s; }
  .book-open-icon svg { width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
  .book-card:hover .book-open-icon { transform:translateY(2px); box-shadow:0 1px 0 #e7dff0; background:#eee7fa; }
  @media(hover:none) { .book-card:hover { transform:none; }.book-card:hover .book-cover { transform:perspective(650px) rotateY(-4deg); } }
  @media(max-width:560px) { .book-card-stage { min-height:175px; padding:.8rem .7rem .5rem; }.book-card-media { width:min(100%,160px); }.book-card-content { padding:.85rem .8rem .9rem; }.book-card-footer { gap:.35rem; }.book-meta { font-size:.62rem; } }
  @media(prefers-reduced-motion:reduce) { .book-card,.book-cover,.book-open-icon { transition:none; } }
</style>
