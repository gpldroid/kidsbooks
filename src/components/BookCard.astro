---
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
}

const { book } = Astro.props;
const base = import.meta.env.BASE_URL;
const coverUrl = `${base}${book.data.cover.replace(/^\/+/, "")}`;
const detailUrl = `${base}libros/${book.data.slug}/`;
---
<article class="book-card group">
  <a class="book-card-link focus-ring" href={detailUrl} aria-label={`Ver el libro ${book.data.title}`}>
    <div class="book-card-stage">
      <div class="book-card-media">
        <span class="book-card-ribbon">PDF GRATIS</span>
        <span class="book-card-glow" aria-hidden="true"></span>
        <img
          src={coverUrl}
          alt={`Portada: ${book.data.title}`}
          loading="lazy"
          decoding="async"
          class="book-cover"
        />
        <span class="book-card-pages" aria-hidden="true"></span>
      </div>
    </div>
    <div class="book-card-content">
      <div class="book-card-tags">
        <span class="book-tag book-tag-category">{book.data.category}</span>
        <span class="book-tag book-tag-free"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5"/><path d="M5 17v4h14v-4"/></svg> Gratis</span>
      </div>
      <h2>{book.data.title}</h2>
      <p class="book-card-description">{book.data.description}</p>
      <div class="book-card-footer">
        <span class="book-meta"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3.5 20v-1.5A5.5 5.5 0 0 1 9 13h.5a5.5 5.5 0 0 1 5.5 5.5V20H3.5Z"/><path d="M16 5.5a3 3 0 0 1 0 5.8"/></svg>{book.data.age} años</span>
        <span class="book-meta"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5h11l3 3V21H5z"/><path d="M8 3.5v6h8v-6M8 21v-7h8v7"/></svg>{book.data.pages} páginas</span>
        <span class="book-open-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9"/></svg></span>
      </div>
    </div>
  </a>
</article>
<style>
  .book-card { height:100%; min-width:0; overflow:hidden; border:1px solid #e2ebe4; border-radius:1.4rem; background:#fff; box-shadow:0 4px 0 rgb(31 90 54 / 6%),0 14px 32px rgb(31 64 43 / 8%); transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease; }
  .book-card:hover { transform:translateY(-5px); border-color:#b7d9c2; box-shadow:0 5px 0 #d4e8da,0 20px 38px rgb(31 64 43 / 12%); }
  .book-card-link { display:flex; height:100%; min-height:100%; flex-direction:column; overflow:hidden; border-radius:inherit; color:inherit; text-decoration:none; }
  .book-card-stage { display:grid; min-height:250px; place-items:center; padding:1.25rem 1rem 1rem; background:linear-gradient(180deg,#f4faf5 0%,#edf5ef 100%); }
  .book-card-media { position:relative; display:grid; width:min(100%,184px); aspect-ratio:3/4; place-items:center; isolation:isolate; }
  .book-card-media::before { position:absolute; z-index:-1; inset:8px -6px -5px 8px; border:1px solid #dce8df; border-radius:.45rem; background:linear-gradient(90deg,#e1e9e2,#fff 20%,#f1f5f1); box-shadow:4px 6px 12px rgb(31 64 43 / 10%); content:""; transform:translateZ(-8px); }
  .book-cover { position:relative; z-index:1; display:block; width:100%; height:100%; border:1px solid #fff; border-radius:.4rem; background:#fff; object-fit:contain; object-position:center; box-shadow:0 8px 18px rgb(31 64 43 / 15%); transform:translateZ(0); transition:transform .3s ease,box-shadow .3s ease; }
  .book-card:hover .book-cover { transform:translateY(-2px); box-shadow:0 12px 22px rgb(31 64 43 / 19%); }
  .book-card-pages { position:absolute; z-index:0; top:5px; right:-5px; bottom:5px; width:7px; border-radius:0 4px 4px 0; background:repeating-linear-gradient(180deg,#fff 0 3px,#e5ece6 3px 4px); }
  .book-card-ribbon { position:absolute; z-index:3; top:10px; left:-5px; padding:.34rem .58rem; border:1px solid #c5e3d4; border-radius:.4rem; background:#e1f4e9; color:#116b3c; font-size:.6rem; font-weight:950; letter-spacing:.055em; box-shadow:0 3px 7px rgb(31 64 43 / 9%); }
  .book-card-glow { position:absolute; z-index:-2; inset:15% 10%; border-radius:50%; background:#cce8d5; filter:blur(24px); opacity:.4; }
  .book-card-content { display:flex; flex:1; flex-direction:column; padding:1.05rem 1.1rem 1.1rem; }
  .book-card-tags { display:flex; min-height:1.7rem; flex-wrap:wrap; align-items:center; gap:.4rem; }
  .book-tag { display:inline-flex; align-items:center; gap:.3rem; border-radius:999px; padding:.32rem .62rem; font-size:.66rem; font-weight:900; }
  .book-tag-category { background:#e8f5ed; color:#16834a; }
  .book-tag-free { background:#e1f4e9; color:#116b3c; }
  .book-tag-free svg,.book-meta svg { flex:0 0 auto; width:.9rem; height:.9rem; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .book-card-content h2 { display:-webkit-box; min-height:2.75em; overflow:hidden; margin:.75rem 0 0; color:#26352d; font-size:1rem; font-weight:950; letter-spacing:-.02em; line-height:1.38; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .book-card-description { display:-webkit-box; min-height:2.9em; overflow:hidden; margin:.45rem 0 1rem; color:#68776d; font-size:.78rem; line-height:1.65; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .book-card-footer { display:flex; min-height:2.2rem; flex-wrap:nowrap; align-items:center; gap:.65rem; margin-top:auto; padding-top:.7rem; border-top:1px solid #edf2ee; }
  .book-meta { display:inline-flex; min-width:0; align-items:center; gap:.28rem; color:#68776d; font-size:.68rem; font-weight:850; white-space:nowrap; }
  .book-open-icon { display:grid; flex:0 0 auto; width:1.85rem; height:1.85rem; place-items:center; margin-left:auto; border:1px solid #dce9df; border-radius:.65rem; background:#edf5ef; color:#16834a; box-shadow:0 3px 0 #e2ebe4; transition:transform .2s,box-shadow .2s,background .2s; }
  .book-open-icon svg { width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
  .book-card:hover .book-open-icon { transform:translateY(2px); box-shadow:0 1px 0 #e2ebe4; background:#e1f4e9; }
  @media(hover:none) { .book-card:hover { transform:none; }.book-card:hover .book-cover { transform:none; } }
  @media(max-width:560px) {
    .book-card { border-radius:1.15rem; }
    .book-card-stage { min-height:190px; padding:.85rem .65rem .7rem; }
    .book-card-media { width:min(100%,142px); }
    .book-card-content { padding:.85rem .8rem .9rem; }
    .book-card-content h2 { font-size:.92rem; }
    .book-card-footer { gap:.35rem; }
    .book-meta { gap:.2rem; font-size:.61rem; }
    .book-open-icon { width:1.65rem; height:1.65rem; }
  }
  @media(prefers-reduced-motion:reduce) { .book-card,.book-cover,.book-open-icon { transition:none; } }
</style>
